--// Aurora Demo — script ví dụ đầy đủ tính năng cơ bản
--// Nhớ upload bản Aurora.lua v2 lên repo trước rồi chạy (link bên dưới)

local Aurora = loadstring(game:HttpGet("https://raw.githubusercontent.com/Nttp1721/rbl/refs/heads/main/Aurora.lua"))()

local Window = Aurora.CreateWindow({
    Title = "Aurora Demo",
    SubTitle = "v2.0 · by Nttp1721",
    Size = UDim2.fromOffset(600, 430),
    TabWidth = 160,
    Theme = "Aurora",                       -- Aurora / Midnight / Rose / Amethyst / Light
    ToggleKey = Enum.KeyCode.RightShift,    -- phím ẩn/hiện (orb 50x50 góc trái dưới, kéo được)
    Splash = true,
})

-- ================================================= TAB 1: TRANG CHÍNH
local Main = Window:AddTab({Title = "Trang chính"})
Main:AddSection({Title = "Tính năng"})

local farming = false
local Progress = Main:AddProgressBar({Title = "Tiến độ farm"})

local Auto = Main:AddToggle({
    Title = "Auto Farm",
    Description = "Tự động farm coin (demo tăng progress)",
    ConfigKey = "autofarm",
    Callback = function(v)
        farming = v
        Aurora.Notify({Title = "Auto Farm", Content = v and "Đã bật" or "Đã tắt", Type = v and "Success" or "Info"})
    end,
})

Main:AddSlider({
    Title = "Tốc độ chạy",
    Description = "Thay WalkSpeed thật của nhân vật",
    Min = 16, Max = 200, Default = 16, Suffix = " ws", ConfigKey = "walkspeed",
    Callback = function(v)
        local char = game:GetService("Players").LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = v end
    end,
})

Main:AddDropdown({
    Title = "Vũ khí",
    Values = {"Kiếm", "Súng", "Cung", "Búa"},
    Default = "Kiếm", ConfigKey = "weapon",
    Callback = function(v) print("Đổi vũ khí:", v) end,
})

Main:AddDropdown({
    Title = "Chọn pet (multi)",
    Values = {"Rồng", "Mèo", "Chó", "Phượng"},
    Multi = true, ConfigKey = "pets",
    Callback = function(list) print("Pets:", table.concat(list, ", ")) end,
})

Main:AddButton({
    Title = "Bắt đầu ngay", Primary = true,
    Description = "Mở hộp thoại xác nhận (Prompt)",
    Callback = function()
        Aurora.Prompt({
            Title = "Xác nhận",
            Content = "Bạn có chắc muốn bắt đầu farm không?",
            ConfirmText = "Bắt đầu", CancelText = "Thôi",
            Callback = function(ok)
                if ok then Auto:Set(true) else Aurora.Notify({Title = "Đã hủy", Type = "Warning"}) end
            end,
        })
    end,
})

-- vòng lặp demo: đẩy progress khi farm đang bật
task.spawn(function()
    local p = 0
    while true do
        task.wait(0.1)
        if farming then
            p = (p + 0.05) % 1
            Progress:Set(p)
        end
    end
end)

-- ================================================= TAB 2: HIỂN THỊ
local Visual = Window:AddTab({Title = "Hiển thị"})

Visual:AddToggle({
    Title = "ESP Người chơi",
    Description = "Demo: đổi màu theo ColorPicker bên dưới",
    ConfigKey = "esp",
    Callback = function(v) print("ESP:", v) end,
})

Visual:AddColorPicker({
    Title = "Màu ESP", Default = Color3.fromRGB(124, 92, 255), ConfigKey = "espcolor",
    Callback = function(c) print("Màu ESP:", c) end,
})

Visual:AddInput({
    Title = "Tên người chơi cần theo dõi",
    PlaceholderText = "Nhập username…", ConfigKey = "target",
    Callback = function(text) print("Target:", text) end,
})

Visual:AddKeybind({
    Title = "Phím bật/tắt farm",
    Default = Enum.KeyCode.F, Mode = "Toggle", ConfigKey = "farmkey",
    Callback = function(v) Auto:Set(v) end,   -- phím F = toggle giống công tắc
})

Visual:AddLabel({
    Title = "Mẹo",
    Description = "Nhấn RightShift để ẩn/hiện GUI, kéo orb tròn sang nơi khác được, cửa sổ thả ra ngoài màn sẽ tự nảy về trong.",
})

-- ================================================= TAB 3: CÀI ĐẶT + LƯU CONFIG
local Settings = Window:AddTab({Title = "Cài đặt"})

Settings:AddDropdown({
    Title = "Theme",
    Values = Aurora.ThemeList(), Default = Aurora.CurrentTheme,
    Callback = function(name) Aurora.SetTheme(name) end,
})

Settings:AddDivider()

Settings:AddButton({
    Title = "Test thông báo",
    Description = "Xem đủ 4 loại: Success / Error / Warning / Info",
    Callback = function()
        Aurora.Notify({Title = "Thành công", Content = "Đã test Success", Type = "Success"})
        task.delay(0.3, function() Aurora.Notify({Title = "Cảnh báo", Content = "Đã test Warning", Type = "Warning"}) end)
        task.delay(0.6, function() Aurora.Notify({Title = "Lỗi", Content = "Đã test Error", Type = "Error"}) end)
        task.delay(0.9, function() Aurora.Notify({Title = "Thông tin", Content = "Đã test Info", Type = "Info", Duration = 2}) end)
    end,
})

-- Tab tự sinh: nhập tên → Lưu / Tải / Xóa config (lưu mọi phần tử có ConfigKey)
Window:AddConfigTab()

-- Thông báo chào sau khi splash chạy xong
task.delay(1.8, function()
    Aurora.Notify({Title = "Aurora Demo", Content = "Loaded thành công! RightShift để ẩn/hiện.", Type = "Success"})
end)
