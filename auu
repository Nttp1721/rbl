-- MEIZU UI LIBRARY v3.0.1 — TEST EXAMPLE
--
-- Local test: đặt MeizuLibrary_v3.0.1.lua cùng thư mục executor rồi chạy file này.
-- GitHub: sau khi ông upload/replace MeizuLibrary.lua bằng v3.0.1, có thể đổi LOCAL_TEST = false.

local LOCAL_TEST = true
local Library

if LOCAL_TEST and readfile and isfile and isfile("MeizuLibrary_v3.0.1.lua") then
    Library = loadstring(readfile("MeizuLibrary_v3.0.1.lua"))()
else
    local url = "https://raw.githubusercontent.com/Nttp1721/rbl/refs/heads/main/MeizuLibrary.lua"
    Library = loadstring(game:HttpGet(url))()
end

local Window = Library.CreateWindow({
    Title = "Meizu Hub",
    SubTitle = "v3.0.1 · Animation Test",
    Theme = "Meizu",
    ToggleKey = Enum.KeyCode.RightShift,
    Size = UDim2.fromOffset(620, 450),
    TabWidth = 165,
})

local Main = Window:AddTab({Title = "Trang chính"})
Main:AddSection({Title = "Controls"})
Main:AddParagraph({
    Title = "Meizu v3.0.1",
    Content = "Test animation, orb, tabs, controls và API Window mới.",
})

local enabled = Main:AddToggle({
    Title = "Auto Farm",
    Default = false,
    ConfigKey = "autofarm",
    Callback = function(v) print("Auto Farm:", v) end,
})

Main:AddSlider({
    Title = "Speed", Min = 16, Max = 200, Default = 50, Suffix = " ws",
    ConfigKey = "speed", Callback = function(v) print("Speed:", v) end,
})

Main:AddDropdown({
    Title = "Weapon",
    Values = {"Sword", "Gun", "Bow"},
    Default = "Gun",
    ConfigKey = "weapon",
    Callback = function(v) print("Weapon:", v) end,
})

Main:AddDropdown({
    Title = "Features",
    Values = {"ESP", "Speed", "Fly", "NoClip"},
    Multi = true,
    Default = {"ESP", "Speed"},
    ConfigKey = "features",
    Callback = function(v) print("Features:", table.concat(v, ", ")) end,
})

Main:AddInput({
    Title = "Player Name", PlaceholderText = "Enter name...",
    ConfigKey = "player_name", Callback = print,
})

Main:AddKeybind({
    Title = "Hotkey", Default = Enum.KeyCode.F, Mode = "Toggle",
    ConfigKey = "hotkey", Callback = function(v) print("Hotkey:", v) end,
})

Main:AddColorPicker({
    Title = "Color", Default = Color3.fromRGB(124, 92, 255),
    ConfigKey = "color", Callback = function(v) print("Color:", v) end,
})

Main:AddProgressBar({Title = "Progress", Default = 0.65, ConfigKey = "progress"})

Main:AddButton({
    Title = "Success Notify", Primary = true,
    Callback = function()
        Library.Notify({Title = "Success", Content = "Animation + Notify OK", Type = "Success"})
    end,
})

Main:AddButton({
    Title = "Prompt",
    Callback = function()
        Library.Prompt({
            Title = "Confirm",
            Content = "Test prompt của Meizu.",
            Callback = function(ok) print("Prompt:", ok) end,
        })
    end,
})

local UI = Window:AddTab({Title = "Animation"})
UI:AddSection({Title = "Window API"})

UI:AddButton({Title = "Center", Primary = true, Callback = function() Window:Center(true) end})
UI:AddButton({Title = "Minimize", Callback = function() Window:Minimize() end})
UI:AddButton({Title = "Restore", Callback = function() Window:Restore() end})
UI:AddButton({
    Title = "Resize", Callback = function()
        local size = Window:GetSize()
        Window:SetSize(size.X.Offset < 680 and UDim2.fromOffset(720, 500) or UDim2.fromOffset(620, 450), true)
    end,
})
UI:AddButton({
    Title = "Change Theme", Callback = function()
        local themes = Library.ThemeList()
        local current = Window:GetTheme()
        local i = table.find(themes, current) or 1
        i = (i % #themes) + 1
        Window:SetTheme(themes[i])
    end,
})

Window:AddConfigTab()

Library.Notify({
    Title = "Meizu v3.0.1",
    Content = "Library loaded successfully.",
    Type = "Success",
    Duration = 3,
})
